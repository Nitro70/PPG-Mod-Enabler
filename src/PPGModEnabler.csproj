<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 and 11, so the exe runs without installing anything. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PPG-Mod-Enabler</AssemblyName>
    <RootNamespace>PPGModEnabler</RootNamespace>
    <Version>1.0.0</Version>
    <Product>PPG Mod Enabler</Product>
    <Description>Re-enables local C# mods in People Playground's safe-mode build.</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="ILRepack" Version="2.0.48" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Merge Mono.Cecil into the exe at build time, so the tool is one plain file with no runtime loading tricks. -->
  <Target Name="MergeIntoSingleExe" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <MergedDir>$(MSBuildProjectDirectory)\..\dist\</MergedDir>
    </PropertyGroup>
    <MakeDir Directories="$(MergedDir)" />
    <Exec Command="&quot;$(PkgILRepack)\tools\ILRepack.exe&quot; /ndebug /out:&quot;$(MergedDir)PPG-Mod-Enabler.exe&quot; &quot;$(TargetDir)PPG-Mod-Enabler.exe&quot; &quot;$(TargetDir)Mono.Cecil.dll&quot;" />
  </Target>

</Project>
